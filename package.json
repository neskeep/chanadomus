{
  "name": "chanadomus",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "MIGRATIONS_DIR=./server/db/migrations node scripts/migrate.mjs",
    "db:seed": "npx tsx --env-file=.env server/db/seed.ts",
    "db:backfill-passes": "npx tsx --env-file=.env server/db/backfill-passes.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:ci": "vitest run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@internationalized/date": "^3.12.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.2.1",
    "better-auth": "^1.6.5",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "jsqr": "^1.4.0",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.4.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.9.7",
    "shadcn-vue": "^2.6.2",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.32",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.0.4",
    "vue-sonner": "^2.0.9",
    "web-push": "^3.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "core-js",
      "esbuild",
      "sharp",
      "vue-demi"
    ]
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "vitest": "^4.1.7"
  }
}
